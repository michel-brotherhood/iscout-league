# Supabase (contact form via the verify-contact edge function)
VITE_SUPABASE_URL=https://seu_project_id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sua_anon_key
VITE_SUPABASE_PROJECT_ID=seu_project_id

# hCaptcha site key (optional). When set, the contact form renders a captcha
# widget and the token is verified server-side by the verify-contact function.
VITE_HCAPTCHA_SITE_KEY=
